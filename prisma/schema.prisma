generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SYSTEM
  ADMIN
  USER
}

enum DriverStatus {
  OFFLINE
  ONLINE
  BUSY
}

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  password              String
  firstName             String?
  lastName              String?
  isActive              Boolean  @default(true)
  forgotPasswordRequest Boolean  @default(false)
  role                  RoleName @default(USER)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  organizationId        String

  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]

  @@map("organizations")
}

model DriverProfile {
  id                 String       @id @default(uuid())
  userId             String       @unique @map("user_id")
  vehicleType        String       @db.VarChar(20) @map("vehicle_type")
  vehiclePlateNumber String       @db.VarChar(15) @map("vehicle_plate_number")
  status             DriverStatus @default(OFFLINE)
  lastKnownLat       Float?       @map("last_known_lat")
  lastKnownLng       Float?       @map("last_known_lng")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@map("driver_profiles")
}