{
  "components": {
    "schemas": {
      "AcquireLockDto": {
        "properties": {
          "resourceKey": {
            "example": "booking:123",
            "type": "string"
          },
          "ttlMs": {
            "example": 30000,
            "minimum": 1,
            "type": "number"
          }
        },
        "required": [
          "resourceKey"
        ],
        "type": "object"
      },
      "ChangePasswordDto": {
        "properties": {
          "currentPassword": {
            "example": "currentPassword123",
            "type": "string"
          },
          "newPassword": {
            "example": "newSecurePassword123",
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object"
      },
      "CreateOrganizationDto": {
        "properties": {
          "description": {
            "example": "A leading technology company",
            "type": "string"
          },
          "logoUrl": {
            "example": "https://acme.com/logo.png",
            "type": "string"
          },
          "name": {
            "example": "Acme Corporation",
            "type": "string"
          },
          "slug": {
            "example": "acme-corp",
            "type": "string"
          },
          "website": {
            "example": "https://acme.com",
            "type": "string"
          }
        },
        "required": [
          "name",
          "slug"
        ],
        "type": "object"
      },
      "LoginDto": {
        "properties": {
          "email": {
            "example": "john@example.com",
            "type": "string"
          },
          "password": {
            "example": "password123",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "RefreshTokenDto": {
        "properties": {
          "refreshToken": {
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ],
        "type": "object"
      },
      "RegisterDto": {
        "properties": {
          "email": {
            "example": "john@example.com",
            "type": "string"
          },
          "firstName": {
            "example": "John",
            "type": "string"
          },
          "lastName": {
            "example": "Doe",
            "type": "string"
          },
          "password": {
            "example": "password123",
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "ReleaseLockDto": {
        "properties": {
          "resourceKey": {
            "example": "booking:123",
            "type": "string"
          },
          "token": {
            "example": "e4f0c1d2-0000-0000-0000-000000000000",
            "type": "string"
          }
        },
        "required": [
          "resourceKey",
          "token"
        ],
        "type": "object"
      },
      "SetPasswordDto": {
        "properties": {
          "newPassword": {
            "example": "newSecurePassword123",
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "newPassword"
        ],
        "type": "object"
      },
      "UpdateLocationDto": {
        "properties": {
          "lat": {
            "example": -6.2,
            "maximum": 90,
            "minimum": -90,
            "type": "number"
          },
          "lng": {
            "example": 106.816666,
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lng"
        ],
        "type": "object"
      },
      "UpdateOrganizationDto": {
        "properties": {
          "description": {
            "example": "A leading technology company",
            "type": "string"
          },
          "logoUrl": {
            "example": "https://acme.com/logo.png",
            "type": "string"
          },
          "name": {
            "example": "Acme Corporation",
            "type": "string"
          },
          "slug": {
            "example": "acme-corp",
            "type": "string"
          },
          "website": {
            "example": "https://acme.com",
            "type": "string"
          }
        },
        "type": "object"
      },
      "UpdateStatusDto": {
        "properties": {
          "status": {
            "enum": [
              "OFFLINE",
              "ONLINE",
              "BUSY"
            ],
            "example": "ONLINE",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "UpdateUserDto": {
        "properties": {
          "email": {
            "example": "john@example.com",
            "type": "string"
          },
          "firstName": {
            "example": "John",
            "type": "string"
          },
          "lastName": {
            "example": "Doe",
            "type": "string"
          },
          "organizationId": {
            "example": "uuid-of-organization",
            "type": "string"
          },
          "password": {
            "example": "password123",
            "minLength": 8,
            "type": "string"
          },
          "roleId": {
            "example": "uuid-of-role",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
