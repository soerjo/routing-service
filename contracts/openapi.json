    "/api/v1/routing/nearby-drivers": {
      "get": {
        "operationId": "RoutingController_getNearbyDrivers",
        "parameters": [
          {
            "name": "lat",
            "required": true,
            "in": "query",
            "schema": {
              "minimum": -90,
              "maximum": 90,
              "example": -6.2,
              "type": "number"
            }
          },
          {
            "name": "lng",
            "required": true,
            "in": "query",
            "schema": {
              "minimum": -180,
              "maximum": 180,
              "example": 106.816666,
              "type": "number"
            }
          },
          {
            "name": "radiusKm",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0.01,
              "default": 5,
              "example": 5,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "example": 10,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Active drivers near a point, nearest first"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "Routing"
        ]
      }
    },
    "/api/v1/routing/route": {
      "get": {
        "operationId": "RoutingController_getRoute",
        "parameters": [
          {
            "name": "originLat",
            "required": true,
            "in": "query",
            "schema": {
              "minimum": -90,
              "maximum": 90,
              "example": -6.2,
              "type": "number"
            }
          },
          {
            "name": "originLng",
            "required": true,
            "in": "query",
            "schema": {
              "minimum": -180,
              "maximum": 180,
              "example": 106.816666,
              "type": "number"
            }
          },
          {
            "name": "destLat",
            "required": true,
            "in": "query",
            "schema": {
              "minimum": -90,
              "maximum": 90,
              "example": -6.175392,
              "type": "number"
            }
          },
          {
            "name": "destLng",
            "required": true,
            "in": "query",
            "schema": {
              "minimum": -180,
              "maximum": 180,
              "example": 106.827153,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Driving route between two points"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "Routing"
        ]
      }
